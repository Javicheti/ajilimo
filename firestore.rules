rules_version = '2';

// AjíLimo · Reglas de Firestore con RBAC por custom claims:
//   request.auth.token.role     → owner | superadmin | admin | supervisor | operator | viewer
//   request.auth.token.tenantId → negocio/organización
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function role() { return request.auth.token.role; }
    function tenant() { return request.auth.token.tenantId; }
    function isOwnerOrSuper() { return role() in ['owner', 'superadmin']; }
    function isAdmin() { return role() == 'admin'; }
    function manager() { return isOwnerOrSuper() || isAdmin(); }
    function sameTenant(t) { return signedIn() && tenant() == t; }

    // Perfil de usuario.
    match /users/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid ||
        (manager() && sameTenant(resource.data.tenantId))
      );
      allow create: if signedIn() && request.auth.uid == uid;
      // No puede cambiarse el propio rol; un manager sí puede gestionar los de su tenant.
      allow update: if signedIn() && (
        (request.auth.uid == uid && request.resource.data.role == resource.data.role) ||
        (manager() && sameTenant(resource.data.tenantId))
      );
      allow delete: if isOwnerOrSuper();
    }

    // Datos multi-tenant.
    match /tenants/{tenantId} {
      allow read: if isOwnerOrSuper() || sameTenant(tenantId);
      allow write: if isOwnerOrSuper() || (isAdmin() && sameTenant(tenantId));

      match /{document=**} {
        allow read: if isOwnerOrSuper() || sameTenant(tenantId);
        allow write: if isOwnerOrSuper() || (isAdmin() && sameTenant(tenantId));
      }
    }

    // Cualquier otra ruta queda cerrada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
