rules_version = '2';

// AjíLimo · Reglas base de Cloud Storage (tenant-aware).
// Evidencia KORN: /tenants/{tenantId}/evidence/{orderId}/{file}
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function hasTenantAccess(tenantId) {
      return isSuperAdmin() ||
        (signedIn() &&
          request.auth.token.tenants != null &&
          request.auth.token.tenants[tenantId] != null);
    }

    match /tenants/{tenantId}/{allPaths=**} {
      allow read: if hasTenantAccess(tenantId);
      allow write: if hasTenantAccess(tenantId) &&
        request.resource.size < 10 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
